APP_ENV=development
SUPABASE_DATABASE_URL_DEV=
DEV_LOGIN_EMAILS=
DEV_COMPANY_ID=
DEV_IDENTITY_SECRET=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=true

CST_WA_GATEWAY_URL=https://wa.cstlogistic.co.id
CST_WA_GATEWAY_TOKEN=
FLEET_WA_DEVICE_ID=

CENTRAL_FINANCE_BASE_URL=https://dev-bizportal.cstlogistic.co.id
CENTRAL_FINANCE_SERVICE_TOKEN=
CENTRAL_FINANCE_WRITE_ENABLED=false

# DEV only: block Fleet leader locks and all WA/Gojek/Finance scheduler jobs.
DISABLE_BACKGROUND_SCHEDULERS=true


# Gojek Fleet Partner connector (disabled by default)
GOJEK_CONNECTOR_ENABLED=false
GOJEK_CONNECTOR_MODE=interactive_export
GOJEK_FLEET_PORTAL_URL=https://fleetpartner.gojek.com
GOJEK_CONNECTOR_ALLOWED_HOST=fleetpartner.gojek.com
GOJEK_CONNECTOR_COMPANY_ID=1
GOJEK_CONNECTOR_SHARED_SECRET=
GOJEK_CONNECTOR_ENCRYPTION_KEY=
GOJEK_CONNECTOR_MAX_FILE_MB=10
GOJEK_CONNECTOR_RETENTION_HOURS=24

# Optional: Fleet Partner login stored as Hostinger/runtime secrets for bridge autofill.
GOJEK_LOGIN_EMAIL=
GOJEK_LOGIN_PASSWORD=


# Server-side Gojek connector. Deploy connector/gojek-server-connector once on an always-on VM/container.
GOJEK_SERVER_CONNECTOR_URL=
GOJEK_SERVER_CONNECTOR_TOKEN=
