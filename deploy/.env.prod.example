APP_ENV=production
NODE_ENV=production
APP_BASE_URL=https://fleet.cstlogistic.co.id
SUPABASE_DATABASE_URL=
DB_POOL_MAX=10
DB_SSL=require

SESSION_SECRET=
FLEET_SESSION_SECRET=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=true

CST_WA_GATEWAY_URL=https://wa.cstlogistic.co.id
CST_WA_GATEWAY_TOKEN=
FLEET_WA_DEVICE_ID=

CENTRAL_FINANCE_BASE_URL=https://bizportal.cstlogistic.co.id
CENTRAL_FINANCE_SERVICE_TOKEN=
CENTRAL_FINANCE_WRITE_ENABLED=false


# Gojek Fleet Partner connector — compliance-first server handoff.
# Does not store Gojek username/password and does not bypass OTP/CAPTCHA.
GOJEK_CONNECTOR_ENABLED=false
GOJEK_CONNECTOR_MODE=interactive_export
GOJEK_FLEET_PORTAL_URL=https://fleetpartner.gojek.com
GOJEK_CONNECTOR_ALLOWED_HOST=fleetpartner.gojek.com
GOJEK_CONNECTOR_COMPANY_ID=1
GOJEK_CONNECTOR_SHARED_SECRET=
GOJEK_CONNECTOR_ENCRYPTION_KEY=
GOJEK_CONNECTOR_MAX_FILE_MB=10
GOJEK_CONNECTOR_RETENTION_HOURS=24

# Optional: Fleet Partner login stored as Hostinger/runtime secrets for bridge autofill.
GOJEK_LOGIN_EMAIL=
GOJEK_LOGIN_PASSWORD=


# Server-side Gojek connector. Deploy connector/gojek-server-connector once on an always-on VM/container.
GOJEK_SERVER_CONNECTOR_URL=
GOJEK_SERVER_CONNECTOR_TOKEN=

# Optional PT Diva Servis assets. Keep OFF until isolated PROD smoke PASS.
FLEET_DIVA_ASSET_READ_ENABLED_PROD=false
FLEET_DIVA_ASSET_DATABASE_URL_PROD=
FLEET_DIVA_TAX_EDIT_ENABLED_PROD=false
# Optional: comma-separated existing Fleet 'admin' emails granted ONLY Diva annual-tax access.
# Leave empty to restrict to Owner/Super Admin. Requires Company-1 signed Fleet session.
FLEET_DIVA_TAX_STAFF_EMAILS_PROD=
FLEET_DIVA_TAX_DATABASE_URL_PROD=
